import 'package:flutter/material.dart';
void main()=>runApp(MaterialApp(home:A()));
class A extends StatefulWidget{State<A> createState()=>B();}
class B extends State<A>{
 final a=TextEditingController(),b=TextEditingController(); double r=0;
 void f(String o){
  var x=double.parse(a.text),y=double.parse(b.text);
  setState(()=>r=o=="+"?x+y:o=="-"?x-y:o=="*"?x*y:x/y);
 }
 Widget build(BuildContext c)=>Scaffold(body:Column(children:[
 TextField(controller:a),TextField(controller:b),
 Row(children:["+","+","*","/"].map((o)=>ElevatedButton(
 onPressed:()=>f(o),child:Text(o))).toList()),Text("$r")
 ]));
}
Output: 10, 5 → + = 15, − = 5, × = 50, ÷ = 24. Change Text
