2. Convert Student Object to Map and Map to Student Object
Code
class Student {
  String name;
  int rollNo;
  String course;

  Student(this.name, this.rollNo, this.course);

  Map<String, dynamic> toMap() =>
      {'name': name, 'rollNo': rollNo, 'course': course};

  factory Student.fromMap(Map<String, dynamic> map) =>
      Student(map['name'], map['rollNo'], map['course']);
}

void main() {
  Student s = Student('Aman', 102, 'BCA');

  Map<String, dynamic> map = s.toMap();
  print(map);

  Student s2 = Student.fromMap(map);
  print('${s2.name}, ${s2.rollNo}, ${s2.course}');
}
Output
{name: Aman, rollNo: 102, course: BCA}
Aman, 102, BCA
