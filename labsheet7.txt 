Q15. Create a Student model classclass Student {
  final int? id;
  final String name;
  final String roll;
  final String course;

  Student({
    this.id,
    required this.name,
    required this.roll,
    required this.course,
  });

  Map<String, dynamic> toMap() => {
    'id': id,
    'name': name,
    'roll': roll,
    'course': course,
  };

  factory Student.fromMap(Map<String, dynamic> map) {
    return Student(
      id: map['id'],
      name: map['name'],
      roll: map['roll'],
      course: map['course'],
    );
  }
}Example use:final student = Student(
  name: 'Aman',
  roll: '101',
  course: 'BCA',
);

await db.insert('students', student.toMap());
print('Student model inserted');
Q16. Create a DatabaseHelper classclass DatabaseHelper {
  Future<Database> get database async {
    return openDatabase(
      join(await getDatabasesPath(), 'college.db'),
      version: 1,
      onCreate: (db, version) async {
        await db.execute(
          'CREATE TABLE students('
          'id INTEGER PRIMARY KEY AUTOINCREMENT,'
          'name TEXT, roll TEXT, course TEXT)',
        );
      },
    );
  }

  Future<int> insert(Map<String, dynamic> data) async {
    final db = await database;
    return db.insert('students', data);
  }

  Future<List<Map<String, dynamic>>> read() async {
    final db = await database;
    return db.query('students');
  }

  Future<int> update(int id, Map<String, dynamic> data) async {
    final db = await database;
    return db.update(
      'students', data,
      where: 'id = ?', whereArgs: [id],
    );
  }

  Future<int> delete(int id) async {
    final db = await database;
    return db.delete(
      'students',
      where: 'id = ?', whereArgs: [id],
    );
  }
}OutputDatabaseHelper supports:
Insert
Read
Update
Delete
