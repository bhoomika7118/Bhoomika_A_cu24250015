Q12. Search/filter API dataimport 'dart:convert';
import 'package:flutter/material.dart';
import 'package:http/http.dart' as http;

void main() => runApp(MaterialApp(home: SearchPage()));

class SearchPage extends StatefulWidget {
  @override
  State<SearchPage> createState() => _SearchPageState();
}

class _SearchPageState extends State<SearchPage> {
  String q = '';

  @override
  Widget build(BuildContext context) => Scaffold(
    body: Column(children: [
      TextField(onChanged: (v) => setState(() => q = v)),
      Expanded(child: FutureBuilder(
        future: http.get(Uri.parse(
          'https://jsonplaceholder.typicode.com/posts')),
        builder: (context, s) {
          if (!s.hasData) return const CircularProgressIndicator();
          final p = jsonDecode(s.data!.body) as List;
          final filtered = p.where((x) =>
            x['title'].toString().toLowerCase()
                .contains(q.toLowerCase())).toList();
          return ListView(children: filtered.map((x) =>
            ListTile(title: Text(x['title'] as String))).toList());
        },
      )),
    ]),
  );
}
