Question 3. Fetch API data using http.get()
Aim: Create a Flutter application that fetches data from a public REST API and displays the response body.
Codeimport 'package:flutter/material.dart';
import 'package:http/http.dart' as http;

void main() => runApp(const MaterialApp(home: ApiPage()));

class ApiPage extends StatefulWidget {
  const ApiPage({super.key});

  @override
  State<ApiPage> createState() => _ApiPageState();
}

class _ApiPageState extends State<ApiPage> {
  String result = 'Press Fetch to load data';

  Future<void> fetchData() async {
    setState(() => result = 'Loading...');

    try {
      final response = await http.get(Uri.parse(
        'https://jsonplaceholder.typicode.com/posts/1',
      ));

      if (response.statusCode == 200) {
        setState(() => result = response.body);
      } else {
        setState(() => result = 'Error: ${response.statusCode}');
      }
    } catch (e) {
      setState(() => result = 'Error: $e');
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('API Data')),
      body: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          children: [
            ElevatedButton(
              onPressed: fetchData,
              child: const Text('Fetch'),
            ),
            Expanded(
              child: SingleChildScrollView(child: Text(result)),
            ),
          ],
        ),
      ),
    );
  }
}
