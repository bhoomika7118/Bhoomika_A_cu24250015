Q10. Handle API errors with Retryimport 'package:flutter/material.dart';
import 'package:http/http.dart' as http;

void main() => runApp(MaterialApp(home: RetryPage()));

class RetryPage extends StatefulWidget {
  @override
  State<RetryPage> createState() => _RetryPageState();
}

class _RetryPageState extends State<RetryPage> {
  late Future<http.Response> f;
  void load() => f = http.get(Uri.parse(
      'https://jsonplaceholder.typicode.com/posts/1'));

  @override
  void initState() { super.initState(); load(); }

  @override
  Widget build(BuildContext context) => Scaffold(
    body: FutureBuilder(
      future: f,
      builder: (context, s) {
        if (s.hasError || (s.hasData && s.data!.statusCode != 200)) {
          return Center(child: ElevatedButton(
            onPressed: () => setState(load),
            child: const Text('Retry')));
        }
        if (!s.hasData) return const CircularProgressIndicator();
        return const Text('Data loaded');
      },
    ),
  );
}
