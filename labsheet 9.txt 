Question: Write a Dart program to parse a JSON array of students into a List<Student> using a fromJson() factory constructor.import 'dart:convert';

class Student {
  final int id;
  final String name;

  Student({required this.id, required this.name});

  factory Student.fromJson(Map<String, dynamic> json) {
    return Student(
      id: json['id'],
      name: json['name'],
    );
  }

  @override
  String toString() => '$id - $name';
}

void main() {
  String jsonData =
      '[{"id":1,"name":"Aman"},'
      '{"id":2,"name":"Priya"}]';

  List data = jsonDecode(jsonData);

  List<Student> students = data
      .map((e) => Student.fromJson(e))
      .toList();

  students.forEach(print);
}

Output

1 - Aman
2 - Priya
