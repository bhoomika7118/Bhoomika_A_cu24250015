Q14. Send data using http.post()import 'dart:convert';
import 'package:flutter/material.dart';
import 'package:http/http.dart' as http;

void main() => runApp(MaterialApp(home: PostForm()));

class PostForm extends StatelessWidget {
  final t = TextEditingController();
  final b = TextEditingController();

  @override
  Widget build(BuildContext context) => Scaffold(
    body: Column(children: [
      TextField(controller: t, decoration:
        const InputDecoration(labelText: 'Title')),
      TextField(controller: b, decoration:
        const InputDecoration(labelText: 'Body')),
      ElevatedButton(
        onPressed: () async {
          final r = await http.post(
            Uri.parse('https://jsonplaceholder.typicode.com/posts'),
            headers: {'Content-Type': 'application/json'},
            body: jsonEncode({
              'title': t.text, 'body': b.text, 'userId': 1
            }),
          );
          ScaffoldMessenger.of(context).showSnackBar(
            SnackBar(content: Text('Status: ${r.statusCode}')));
        },
        child: const Text('Submit'),
      ),
    ]),
  );
}
Q15. Product Store using GridViewimport 'dart:convert';
import 'package:flutter/material.dart';
import 'package:http/http.dart' as http;

void main() => runApp(MaterialApp(home: Store()));

class Store extends StatelessWidget {
  Future<List> products() async => jsonDecode((await http.get(
    Uri.parse('https://dummyjson.com/products'))).body)['products'];

  @override
  Widget build(BuildContext context) => Scaffold(
    appBar: AppBar(title: const Text('Product Store')),
    body: FutureBuilder(
      future: products(),
      builder: (context, s) {
        if (!s.hasData) return const Center(
          child: CircularProgressIndicator());
        final p = s.data!;
        return GridView.builder(
          itemCount: p.length,
          gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
            crossAxisCount: 2),
          itemBuilder: (context, i) => Card(
            child: InkWell(
              onTap: () => Navigator.push(context, MaterialPageRoute(
                builder: (_) => Scaffold(
                  body: Center(child: Text(
                    '${p[i]['title']}\n\$${p[i]['price']}')))),
              child: Column(children: [
                Expanded(child: Image.network(p[i]['thumbnail'])),
                Text(p[i]['title']),
                Text('\$${p[i]['price']}'),
              ]),
            ),
          ),
        );
      },
    ),
  );
}